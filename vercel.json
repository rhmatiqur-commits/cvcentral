{
  "version": 2,
  "functions": {
    "api/ai.js": { "maxDuration": 60 },
    "api/chat.js": { "maxDuration": 15 },
    "api/payment.js": { "maxDuration": 30 },
    "api/webhook.js": { "maxDuration": 30 },
    "api/admin-feedback.js": { "maxDuration": 15 },
    "api/admin-data.js": { "maxDuration": 15 },
    "api/admin-analytics.js": { "maxDuration": 15 },
    "api/export-docx.js":     { "maxDuration": 30 },
    "api/tracker.js":         { "maxDuration": 15 },
    "api/linkedin-optimiser.js": { "maxDuration": 60 },
    "api/saved-data.js":         { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
